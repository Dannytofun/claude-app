{
  "name": "aliran-cashflow",
  "version": "1.0.0",
  "description": "Personal cashflow and bill manager for Malaysia: web app plus a secure Node.js backend.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server/server.js",
    "dev": "npm run build && node --watch-path=server --watch-path=public server/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm audit --omit=dev --audit-level=high",
    "gen-key": "node scripts/gen-key.js",
    "backup-db": "node scripts/backup-db.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "24.1.3"
  }
}
