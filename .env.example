# Copy to .env (never commit .env). Every value has a safe development default.

# development | production. Production refuses to start without the settings marked REQUIRED.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# REQUIRED in production: 32 random bytes, base64. Generate with: npm run gen-key
# Losing this key means losing access to all stored data. Keep it in a password manager or secret store,
# separate from database backups.
DATA_ENCRYPTION_KEY=

# REQUIRED in production: the https:// address people use to reach the app.
PUBLIC_ORIGIN=

# Who can create accounts: first (only the first person, then closed), open, or closed.
REGISTRATION=first

# Set to true only when running behind a reverse proxy (Caddy, nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

# Defaults to true in production. Never turn off outside local development.
# SECURE_COOKIES=true

DATA_DIR=./data
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=168
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info
